generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cuenta {
  id_cuenta         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo            String       @unique
  claveHash         String       @map("clave_hash")
  telefono          String
  estado            EstadoCuenta @default(PENDIENTE)
  fechaCreacion     DateTime     @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion DateTime     @default(now()) @map("fecha_modificacion") @db.Timestamptz(6)
  eliminado         Boolean      @default(false)
  fk_modificado_por String?      @db.Uuid
  bloqueado         Boolean      @default(false)
  fechaBloqueo      DateTime?    @map("fecha_bloqueo") @db.Timestamptz(6)
  motivoBloqueo     String?      @map("motivo_bloqueo")

  cuenta       Cuenta?   @relation("cuentaTocuenta", fields: [fk_modificado_por], references: [id_cuenta], onUpdate: NoAction, map: "fk_cuenta_modificado_por")
  other_cuenta Cuenta[]  @relation("cuentaTocuenta")
  log_api      log_api[]
  sede         Sede[]
  usuario      Usuario?

  @@index([fk_modificado_por], map: "idx_cuenta_modificado_por")
  @@map("cuenta")
}

model RolUsuario {
  id          Int       @id @default(autoincrement())
  descripcion String    @unique
  usuario     Usuario[]

  @@map("rol_usuario")
}

model Sede {
  id                Int      @id @default(autoincrement())
  nombre            String
  activa            Boolean  @default(true)
  fechaCreacion     DateTime @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion DateTime @default(now()) @map("fecha_modificacion") @db.Timestamptz(6)
  eliminado         Boolean  @default(false)
  fk_modificado_por String?  @db.Uuid

  cuenta  Cuenta?   @relation(fields: [fk_modificado_por], references: [id_cuenta], onUpdate: NoAction, map: "fk_sede_modificado_por")
  usuario Usuario[]

  @@index([fk_modificado_por], map: "idx_sede_modificado_por")
  @@map("sede")
}

model Usuario {
  id_cuenta      String  @id @db.Uuid
  run            String  @unique
  pNombre        String  @map("p_nombre")
  sNombre        String? @map("s_nombre")
  pApellido      String  @map("p_apellido")
  sApellido      String  @map("s_apellido")
  fk_rol_usuario Int
  fk_sede        Int

  rol_usuario RolUsuario @relation(fields: [fk_rol_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sede        Sede       @relation(fields: [fk_sede], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cuenta      Cuenta     @relation(fields: [id_cuenta], references: [id_cuenta], onDelete: Cascade, onUpdate: NoAction)

  @@index([fk_rol_usuario], map: "idx_usuario_rol")
  @@index([fk_sede], map: "idx_usuario_sede")
  @@map("usuario")
}

model log_api {
  id            BigInt   @id @default(autoincrement())
  metodo        String
  ruta          String
  codigo_estado Int
  mensaje_error String?
  fk_cuenta     String?  @db.Uuid
  fecha_hora    DateTime @default(now()) @db.Timestamptz(6)

  cuenta Cuenta? @relation(fields: [fk_cuenta], references: [id_cuenta], onUpdate: NoAction)

  @@index([fk_cuenta], map: "idx_log_api_cuenta")
  @@index([fecha_hora], map: "idx_log_api_fecha_hora")
}

enum EstadoCuenta {
  PENDIENTE
  ACTIVA

  @@map("estado_cuenta")
}
