generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Cuenta {
  id_cuenta         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correo            String         @unique
  claveHash         String         @map("clave_hash")
  telefono          String
  fechaCreacion     DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion DateTime       @default(now()) @map("fecha_modificacion") @db.Timestamptz(6)
  eliminado         Boolean        @default(false)
  fk_modificado_por String?        @db.Uuid
  bloqueado         Boolean        @default(false)
  fechaBloqueo      DateTime?      @map("fecha_bloqueo") @db.Timestamptz(6)
  motivoBloqueo     String?        @map("motivo_bloqueo")
  aprobada          Boolean        @default(true)
  cuenta            Cuenta?        @relation("cuentaTocuenta", fields: [fk_modificado_por], references: [id_cuenta], onUpdate: NoAction, map: "fk_cuenta_modificado_por")
  other_cuenta      Cuenta[]       @relation("cuentaTocuenta")
  log_api           log_api[]
  refreshTokens     RefreshToken[]
  accessTokensRevocados AccessTokenRevocado[]
  sede              Sede[]
  usuario           Usuario?
  publicacionesCompradas    Publicacion[] @relation("publicacionComprador")
  publicacionesModificadas  Publicacion[] @relation("publicacionModificadaPor")

  @@index([fk_modificado_por], map: "idx_cuenta_modificado_por")
  @@map("cuenta")
}

model RolUsuario {
  id          Int       @id @default(autoincrement())
  descripcion String    @unique
  usuario     Usuario[]

  @@map("rol_usuario")
}

model Sede {
  id                Int       @id @default(autoincrement())
  nombre            String    @unique
  activa            Boolean   @default(true)
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion DateTime  @default(now()) @map("fecha_modificacion") @db.Timestamptz(6)
  eliminado         Boolean   @default(false)
  fk_modificado_por String?   @db.Uuid
  cuenta            Cuenta?   @relation(fields: [fk_modificado_por], references: [id_cuenta], onUpdate: NoAction, map: "fk_sede_modificado_por")
  // Fase A (HU-UBI-01, ES-MIG-A): comunaId nace nullable; se vuelve NOT NULL
  // recién en la fase D, tras el gate de sedes sin territorializar.
  comunaId          Int?      @map("fk_comuna")
  comuna            Comuna?   @relation(fields: [comunaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario           Usuario[]
  publicaciones     Publicacion[]

  @@index([fk_modificado_por], map: "idx_sede_modificado_por")
  @@index([comunaId], map: "idx_sede_comuna")
  @@map("sede")
}

model Region {
  id            Int     @id @default(autoincrement())
  nombre        String
  codigoSubdere String  @unique @map("codigo_subdere")

  ciudades Ciudad[]
  comunas  Comuna[]

  @@map("region")
}

model Ciudad {
  id        Int     @id @default(autoincrement())
  idEntidad String? @unique @map("id_entidad")
  nombre    String
  regionId  Int     @map("fk_region")
  comunaId  Int?    @map("fk_comuna")

  region Region  @relation(fields: [regionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comuna Comuna? @relation(fields: [comunaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([regionId], map: "idx_ciudad_region")
  @@index([comunaId], map: "idx_ciudad_comuna")
  @@map("ciudad")
}

model Comuna {
  id            Int    @id @default(autoincrement())
  nombre        String
  codigoSubdere String @unique @map("codigo_subdere")
  regionId      Int    @map("fk_region")

  region   Region   @relation(fields: [regionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ciudades Ciudad[]
  sedes    Sede[]

  @@index([regionId], map: "idx_comuna_region")
  @@map("comuna")
}

model Escuela {
  id       Int       @id @default(autoincrement())
  nombre   String
  carreras Carrera[]

  @@map("escuela")
}

model Carrera {
  id         Int       @id @default(autoincrement())
  nombre     String
  fk_escuela Int
  escuela    Escuela   @relation(fields: [fk_escuela], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios   Usuario[]

  @@index([fk_escuela], map: "idx_carrera_escuela")
  @@map("carrera")
}

model Usuario {
  id_cuenta      String     @id @db.Uuid
  run            String     @unique
  pNombre        String     @map("p_nombre")
  sNombre        String?    @map("s_nombre")
  pApellido      String     @map("p_apellido")
  sApellido      String     @map("s_apellido")
  fk_rol_usuario Int
  fk_sede        Int
  fk_carrera     Int
  carrera        Carrera    @relation(fields: [fk_carrera], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rol_usuario    RolUsuario @relation(fields: [fk_rol_usuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sede           Sede       @relation(fields: [fk_sede], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cuenta         Cuenta     @relation(fields: [id_cuenta], references: [id_cuenta], onDelete: Cascade, onUpdate: NoAction)
  publicaciones  Publicacion[]

  @@index([fk_rol_usuario], map: "idx_usuario_rol")
  @@index([fk_sede], map: "idx_usuario_sede")
  @@index([fk_carrera], map: "idx_usuario_carrera")
  @@map("usuario")
}

model log_api {
  id            BigInt   @id @default(autoincrement())
  metodo        String
  ruta          String
  codigo_estado Int
  mensaje_error String?
  fk_cuenta     String?  @db.Uuid
  fecha_hora    DateTime @default(now()) @db.Timestamptz(6)
  cuenta        Cuenta?  @relation(fields: [fk_cuenta], references: [id_cuenta], onUpdate: NoAction)

  @@index([fk_cuenta], map: "idx_log_api_cuenta")
  @@index([fecha_hora], map: "idx_log_api_fecha_hora")
}

model RefreshToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fk_cuenta       String    @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaExpiracion DateTime  @map("fecha_expiracion") @db.Timestamptz(6)
  fechaRevocacion DateTime? @map("fecha_revocacion") @db.Timestamptz(6)

  cuenta Cuenta @relation(fields: [fk_cuenta], references: [id_cuenta], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_token_cuenta")

  @@index([fk_cuenta], map: "idx_refresh_token_cuenta")
  @@map("refresh_token")
}

model AccessTokenRevocado {
  jti             String   @id
  fk_cuenta       String   @db.Uuid
  fechaExpiracion DateTime @map("fecha_expiracion") @db.Timestamptz(6)

  cuenta Cuenta @relation(fields: [fk_cuenta], references: [id_cuenta], onDelete: Cascade, onUpdate: NoAction, map: "fk_access_token_revocado_cuenta")

  @@index([fk_cuenta], map: "idx_access_token_revocado_cuenta")
  @@index([fechaExpiracion], map: "idx_access_token_revocado_expiracion")
  @@map("access_token_revocado")
}

model TipoVenta {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  publicacion Publicacion[]

  @@map("tipoventa")
}

model Categoria {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  publicacion Publicacion[]

  @@map("categoria")
}

model EstadoPublicacion {
  id          Int           @id @default(autoincrement())
  descripcion String        @unique
  publicacion Publicacion[]

  @@map("estado_publicacion")
}

model Publicacion {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo                String
  descripcion           String
  precio                Int
  fk_estado_publicacion Int
  fk_tipoventa          Int
  fk_categoria          Int
  fk_usuario            String    @db.Uuid
  fk_sede               Int
  fk_user_comprador     String?   @db.Uuid
  contador_vistas       Int       @default(0)
  fechaCreacion         DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaModificacion     DateTime  @default(now()) @map("fecha_modificacion") @db.Timestamptz(6)
  eliminado             Boolean   @default(false)
  fk_modificado_por     String?   @db.Uuid

  estadoPublicacion EstadoPublicacion @relation(fields: [fk_estado_publicacion], references: [id], onUpdate: NoAction)
  tipoVenta         TipoVenta         @relation(fields: [fk_tipoventa], references: [id], onUpdate: NoAction)
  categoria         Categoria         @relation(fields: [fk_categoria], references: [id], onUpdate: NoAction)
  usuario           Usuario           @relation(fields: [fk_usuario], references: [id_cuenta], onUpdate: NoAction)
  sede              Sede              @relation(fields: [fk_sede], references: [id], onUpdate: NoAction)
  comprador         Cuenta?           @relation("publicacionComprador", fields: [fk_user_comprador], references: [id_cuenta], onUpdate: NoAction)
  modificadoPor     Cuenta?           @relation("publicacionModificadaPor", fields: [fk_modificado_por], references: [id_cuenta], onUpdate: NoAction)
  imagenes          ImagenPublicacion[]

  @@index([fk_estado_publicacion], map: "idx_publicacion_estado")
  @@index([fk_tipoventa], map: "idx_publicacion_tipoventa")
  @@index([fk_categoria], map: "idx_publicacion_categoria")
  @@index([fk_usuario], map: "idx_publicacion_usuario")
  @@index([fk_sede], map: "idx_publicacion_sede")
  @@index([fk_user_comprador], map: "idx_publicacion_comprador")
  @@index([fk_modificado_por], map: "idx_publicacion_modificado_por")
  @@map("publicacion")
}

model ImagenPublicacion {
  idImagen       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid @map("id_imagen")
  fk_publicacion String @db.Uuid
  url            String
  orden          Int

  publicacion Publicacion @relation(fields: [fk_publicacion], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([fk_publicacion, orden], map: "ux_imagen_publicacion_publicacion_orden")
  @@index([fk_publicacion], map: "idx_imagen_publicacion_publicacion")
  @@map("imagen_publicacion")
}
