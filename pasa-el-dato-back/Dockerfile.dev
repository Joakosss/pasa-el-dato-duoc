FROM node:22-slim

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.5.1 --activate

WORKDIR /app

# Evita que pnpm pida confirmación interactiva (sin TTY en contenedor)
ENV CI=true
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0

COPY package.json pnpm-lock.yaml* ./
# --ignore-scripts: evita que pnpm 10+ falle por build scripts ignorados.
# En dev no los necesitamos; en prod se usa approve-builds.
RUN pnpm install --frozen-lockfile --ignore-scripts 2>/dev/null || pnpm install --ignore-scripts

COPY . .

EXPOSE 3001

# nest start --watch escucha en process.env.PORT (main.ts).
# compose.yaml inyecta PORT=${API_PORT}, así el host y el contenedor usan el mismo puerto.
# Se invoca nest directo con node para saltar el chequeo auto de pnpm 11
# (verify-deps-before-run corre `pnpm install` sin --ignore-scripts y falla
# con ERR_PNPM_IGNORED_BUILDS -> loop de reinicios).
CMD ["node", "node_modules/@nestjs/cli/bin/nest.js", "start", "--watch"]
