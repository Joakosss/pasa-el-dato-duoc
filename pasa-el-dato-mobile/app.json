{
  "expo": {
    "name": "Pasa el Dato Duoc",
    "slug": "pasa-el-dato-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-splash.png",
    "scheme": "pasaeldatomobile",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/logo-splash.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFB819",
        "foregroundImage": "./assets/images/logo-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-splash.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite que Pasa el Dato use tu cámara para fotografiar tus productos.",
          "photosPermission": "Permite que Pasa el Dato acceda a tus fotos para publicar productos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Pasa el Dato use tu ubicación para mostrar publicaciones cercanas. Tu ubicación no se guarda."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFB819",
          "image": "./assets/images/logo-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "23db0cc3-79e9-4b21-8d50-7828b7ca4c9a"
      }
    },
    "owner": "k.oublier"
  }
}
